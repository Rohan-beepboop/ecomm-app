<%-- Page chrome (top). Requires taglibs.jspf to have been included by the host page. --%>
<c:set var="ctx" value="${pageContext.request.contextPath}" scope="request"/>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${empty pageTitle ? 'Store' : pageTitle}"/> | Meridian Goods</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="${ctx}/css/style.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-md navbar-dark site-nav">
  <div class="container">
    <a class="navbar-brand brand" href="${ctx}/catalog">Meridian Goods</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="${ctx}/catalog">Shop</a></li>
        <c:if test="${not empty sessionScope.user and sessionScope.user.admin}">
          <li class="nav-item"><a class="nav-link" href="${ctx}/admin/products">Inventory</a></li>
        </c:if>
        <c:if test="${not empty sessionScope.user}">
          <li class="nav-item"><a class="nav-link" href="${ctx}/orders">My orders</a></li>
        </c:if>
      </ul>
      <ul class="navbar-nav align-items-md-center gap-md-2">
        <li class="nav-item">
          <a class="nav-link" href="${ctx}/cart">Cart
            <span class="badge cart-badge"><c:out value="${empty sessionScope.cart ? 0 : sessionScope.cart.itemCount}"/></span>
          </a>
        </li>
        <c:choose>
          <c:when test="${not empty sessionScope.user}">
            <li class="nav-item"><span class="navbar-text small">Signed in as <c:out value="${sessionScope.user.fullName}"/></span></li>
            <li class="nav-item"><a class="nav-link" href="${ctx}/logout">Log out</a></li>
          </c:when>
          <c:otherwise>
            <li class="nav-item"><a class="nav-link" href="${ctx}/login">Log in</a></li>
            <li class="nav-item"><a class="btn btn-sm btn-accent" href="${ctx}/register">Create account</a></li>
          </c:otherwise>
        </c:choose>
      </ul>
    </div>
  </div>
</nav>
<main class="container py-4 flex-grow-1">
  <c:if test="${not empty requestScope.flash}">
    <div class="alert alert-${requestScope.flash[0]} alert-dismissible fade show" role="alert" data-autodismiss>
      <c:out value="${requestScope.flash[1]}"/>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </c:if>
